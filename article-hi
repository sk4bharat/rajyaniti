<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>वैदिक सभ्यता: वह सत्य जो पाठ्यपुस्तकों ने छुपाया — sk4bharat</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Noto+Serif+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --saffron: #E8600A;
    --deep-red: #8B1A1A;
    --ink: #1A1208;
    --parchment: #FAF6EE;
    --cream: #F5EFE0;
    --gold: #C8922A;
    --warm-gray: #8A7968;
    --border: #DDD5C0;
    --text: #2C2010;
    --muted: #7A6E5A;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }

  body {
    background: var(--parchment);
    color: var(--text);
    font-family: 'Noto Serif Devanagari', 'EB Garamond', Georgia, serif;
    font-size: 18px;
    line-height: 1.9;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9999;
    opacity: 0.4;
  }

  /* ─── HEADER ─── */
  header {
    background: var(--ink);
    padding: 0 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 3px solid var(--saffron);
  }
  .logo { padding: 1rem 0; text-decoration: none; }
  .logo-text { font-family: 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: var(--parchment); letter-spacing: -0.02em; }
  .logo-text span { color: var(--saffron); }
  .logo-sub { font-family: 'DM Sans', sans-serif; font-size: 0.65rem; color: var(--warm-gray); letter-spacing: 0.2em; text-transform: uppercase; display: block; margin-top: -2px; }
  nav { display: flex; align-items: center; gap: 0.2rem; }
  nav a { font-family: 'DM Sans', sans-serif; font-size: 0.8rem; color: #BBB; text-decoration: none; padding: 0.5rem 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; transition: color 0.2s; }
  nav a:hover { color: var(--saffron); }
  nav .nav-cta { background: var(--saffron); color: white; padding: 0.45rem 1rem; border-radius: 2px; font-weight: 500; margin-left: 0.5rem; }
  nav .nav-cta:hover { background: #c94f00; }
  .hamburger { display: none; background: none; border: none; cursor: pointer; flex-direction: column; gap: 5px; padding: 5px; z-index: 201; }
  .hamburger span { display: block; width: 24px; height: 2px; background: var(--parchment); transition: all 0.3s; }
  .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-nav { display: flex; position: fixed; inset: 0; background: var(--ink); z-index: 200; flex-direction: column; align-items: center; justify-content: center; gap: 1.5rem; opacity: 0; transform: translateX(100%); transition: opacity 0.3s ease, transform 0.3s ease; visibility: hidden; pointer-events: none; }
  .mobile-nav.open { opacity: 1; transform: translateX(0); visibility: visible; pointer-events: all; }
  .mobile-link { font-family: 'Playfair Display', serif; font-size: 2rem; font-style: italic; color: var(--parchment); text-decoration: none; transition: color 0.2s; }
  .mobile-link:hover { color: var(--saffron); }

  /* ─── LANGUAGE BAR ─── */
  #rj-lang-bar {
    background: #0D0A05;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.6rem 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .rj-lb-btn {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: #888;
    background: transparent;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px;
    padding: 0.35rem 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .rj-lb-btn.active {
    background: var(--saffron);
    border-color: var(--saffron);
    color: white;
  }

  /* ─── PROGRESS BAR ─── */
  #progress-bar { position: fixed; top: 0; left: 0; width: 0%; height: 3px; background: linear-gradient(90deg, var(--saffron), var(--gold)); z-index: 9998; transition: width 0.1s linear; }

  /* ─── MASTHEAD ─── */
  .article-masthead { background: var(--ink); padding: 5rem 2rem 0; position: relative; overflow: hidden; }
  .article-masthead::before { content: '✦'; position: absolute; font-size: 40rem; color: rgba(255,255,255,0.015); top: -10rem; right: -5rem; line-height: 1; pointer-events: none; font-family: 'Playfair Display', serif; }
  .masthead-inner { max-width: 820px; margin: 0 auto; position: relative; z-index: 1; }

  .article-breadcrumb { font-family: 'DM Sans', sans-serif; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--warm-gray); margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem; }
  .article-breadcrumb a { color: var(--warm-gray); text-decoration: none; transition: color 0.2s; }
  .article-breadcrumb a:hover { color: var(--saffron); }
  .article-breadcrumb .sep { color: #444; }

  .article-category-badge { display: inline-block; font-family: 'DM Sans', sans-serif; font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--saffron); border: 1px solid var(--saffron); padding: 0.25rem 0.75rem; border-radius: 2px; margin-bottom: 1.5rem; }

  .article-main-title { font-family: 'Noto Serif Devanagari', 'Playfair Display', serif; font-size: clamp(2rem, 4.5vw, 3.4rem); font-weight: 700; color: var(--parchment); line-height: 1.18; margin-bottom: 1.5rem; animation: fadeUp 0.7s ease both; }
  .article-main-title em { font-style: italic; color: var(--gold); }

  .article-dek { font-family: 'Noto Serif Devanagari', 'EB Garamond', serif; font-size: 1.15rem; font-style: italic; color: #AAA09A; line-height: 1.8; max-width: 62ch; margin-bottom: 2.5rem; animation: fadeUp 0.7s ease 0.1s both; }

  .article-meta-bar { display: flex; align-items: center; gap: 2rem; flex-wrap: wrap; padding: 1.5rem 0; border-top: 1px solid rgba(255,255,255,0.1); animation: fadeUp 0.7s ease 0.2s both; }
  .meta-author { display: flex; align-items: center; gap: 0.8rem; }
  .author-avatar { width: 40px; height: 40px; background: linear-gradient(135deg, #3d2b10, var(--saffron)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-style: italic; color: var(--parchment); font-size: 0.9rem; flex-shrink: 0; }
  .author-info-name { font-family: 'DM Sans', sans-serif; font-size: 0.82rem; font-weight: 500; color: var(--parchment); }
  .author-info-role { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; color: var(--warm-gray); letter-spacing: 0.1em; }
  .meta-divider { width: 1px; height: 28px; background: rgba(255,255,255,0.12); }
  .meta-item { font-family: 'DM Sans', sans-serif; font-size: 0.72rem; color: var(--warm-gray); letter-spacing: 0.08em; text-transform: uppercase; display: flex; flex-direction: column; gap: 0.15rem; }
  .meta-item strong { color: #CCC; font-weight: 500; font-size: 0.78rem; }

  .article-tags-bar { display: flex; gap: 0.5rem; flex-wrap: wrap; padding: 1.5rem 0 0; animation: fadeUp 0.7s ease 0.3s both; }
  .tag { font-family: 'DM Sans', sans-serif; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(255,255,255,0.06); color: #AAA; border: 1px solid rgba(255,255,255,0.12); padding: 0.25rem 0.65rem; border-radius: 999px; cursor: pointer; transition: all 0.2s; text-decoration: none; }
  .tag:hover { background: var(--saffron); color: white; border-color: var(--saffron); }

  /* ─── HERO IMAGE ─── */
  .masthead-image-strip { background: var(--ink); padding: 2.5rem 2rem 0; }
  .masthead-image { max-width: 820px; margin: 0 auto; }
  .hero-image-block { width: 100%; height: 340px; background: linear-gradient(135deg, #1f0a00 0%, #3a1500 40%, #1a0800 100%); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
  .hero-image-block::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 50%, rgba(232,96,10,0.15) 0%, transparent 65%), radial-gradient(ellipse at 80% 60%, rgba(200,146,42,0.1) 0%, transparent 55%); }
  .hero-image-placeholder { font-family: 'Playfair Display', serif; font-size: 6rem; font-style: italic; color: rgba(232,96,10,0.2); user-select: none; z-index: 1; position: relative; }
  .hero-image-caption { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; color: #555; letter-spacing: 0.05em; padding: 0.6rem 0 0; font-style: italic; }

  /* ─── ARTICLE BODY ─── */
  .article-body-wrapper { padding: 4rem 2rem; background: var(--parchment); }
  .article-layout { max-width: 820px; margin: 0 auto; display: grid; grid-template-columns: 1fr 220px; gap: 4rem; align-items: start; }
  .article-prose { min-width: 0; }

  .article-prose .drop-cap::first-letter { font-family: 'Noto Serif Devanagari', serif; font-size: 4.8rem; font-weight: 700; float: left; line-height: 0.85; margin-right: 0.1em; margin-top: 0.08em; color: var(--saffron); }
  .article-prose p { font-size: 1.08rem; line-height: 1.95; color: var(--text); margin-bottom: 1.6rem; font-family: 'Noto Serif Devanagari', serif; }
  .article-prose h2 { font-family: 'Noto Serif Devanagari', 'Playfair Display', serif; font-size: 1.6rem; font-weight: 700; color: var(--ink); margin: 3rem 0 1.2rem; line-height: 1.3; }
  .article-prose h3 { font-family: 'Noto Serif Devanagari', 'Playfair Display', serif; font-size: 1.2rem; font-weight: 600; color: var(--ink); margin: 2rem 0 0.8rem; }

  .article-prose blockquote { border-left: 3px solid var(--saffron); margin: 2.5rem 0; padding: 0.5rem 0 0.5rem 2rem; }
  .article-prose blockquote p { font-family: 'Noto Serif Devanagari', serif; font-size: 1.2rem; font-style: italic; color: var(--ink); margin-bottom: 0.6rem; line-height: 1.6; }
  .article-prose blockquote cite { font-family: 'DM Sans', sans-serif; font-size: 0.72rem; color: var(--muted); letter-spacing: 0.12em; text-transform: uppercase; font-style: normal; }

  .article-prose .pull-quote { background: var(--cream); border-top: 3px solid var(--saffron); border-bottom: 1px solid var(--border); padding: 2rem 2.5rem; margin: 2.5rem 0; text-align: center; }
  .article-prose .pull-quote p { font-family: 'Noto Serif Devanagari', serif; font-size: 1.35rem; font-style: italic; color: var(--ink); line-height: 1.5; margin-bottom: 0; }

  .article-prose hr { border: none; text-align: center; color: var(--saffron); font-size: 1.2rem; letter-spacing: 0.6em; margin: 3rem 0; }
  .article-prose hr::after { content: '✦  ✦  ✦'; }
  .article-prose strong { color: var(--ink); font-weight: 700; }
  .article-prose em { color: var(--deep-red); font-style: italic; }
  .article-prose a { color: var(--saffron); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .article-prose a:hover { color: var(--deep-red); }

  .article-signature { border-top: 1px solid var(--border); padding-top: 2rem; margin-top: 3rem; display: flex; align-items: center; gap: 1.2rem; }
  .signature-avatar { width: 56px; height: 56px; background: linear-gradient(135deg, #3d2b10, var(--saffron)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-family: 'Playfair Display', serif; font-style: italic; color: var(--parchment); font-size: 1.1rem; flex-shrink: 0; }
  .signature-name { font-family: 'Noto Serif Devanagari', serif; font-size: 1.1rem; font-weight: 600; color: var(--ink); margin-bottom: 0.2rem; }
  .signature-bio { font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--muted); line-height: 1.5; }

  .article-actions { display: flex; align-items: center; gap: 0.75rem; margin: 2rem 0 3rem; flex-wrap: wrap; }
  .action-btn { font-family: 'DM Sans', sans-serif; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500; padding: 0.55rem 1.1rem; border-radius: 2px; border: 1px solid var(--border); background: transparent; color: var(--muted); cursor: pointer; transition: all 0.2s; display: inline-flex; align-items: center; gap: 0.4rem; }
  .action-btn:hover { border-color: var(--saffron); color: var(--saffron); }
  .action-btn.active { background: var(--saffron); border-color: var(--saffron); color: white; }
  .action-divider { flex: 1; }
  .reading-time-pill { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--border); padding: 0.35rem 0.85rem; border-radius: 999px; }

  /* ─── SIDEBAR ─── */
  .article-sidebar { position: sticky; top: 90px; display: flex; flex-direction: column; gap: 2.5rem; }
  .sidebar-block { border-top: 3px solid var(--border); padding-top: 1.2rem; }
  .sidebar-block.accent { border-color: var(--saffron); }
  .sidebar-label { font-family: 'DM Sans', sans-serif; font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--saffron); margin-bottom: 1rem; }

  .toc-list { list-style: none; display: flex; flex-direction: column; gap: 0.5rem; }
  .toc-list li a { font-family: 'DM Sans', sans-serif; font-size: 0.78rem; color: var(--muted); text-decoration: none; display: flex; align-items: flex-start; gap: 0.5rem; line-height: 1.4; transition: color 0.2s; }
  .toc-list li a::before { content: ''; width: 12px; height: 1px; background: var(--border); margin-top: 0.6rem; flex-shrink: 0; transition: background 0.2s, width 0.2s; }
  .toc-list li a:hover { color: var(--saffron); }
  .toc-list li a:hover::before { background: var(--saffron); width: 18px; }
  .toc-list li.active a { color: var(--ink); font-weight: 500; }
  .toc-list li.active a::before { background: var(--saffron); width: 18px; }

  .related-item { border-bottom: 1px solid var(--border); padding-bottom: 1rem; margin-bottom: 1rem; }
  .related-item:last-child { border-bottom: none; margin-bottom: 0; }
  .related-meta { font-family: 'DM Sans', sans-serif; font-size: 0.62rem; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.3rem; }
  .related-title { font-family: 'Noto Serif Devanagari', serif; font-size: 0.88rem; font-weight: 600; color: var(--ink); line-height: 1.3; text-decoration: none; display: block; transition: color 0.2s; }
  .related-title:hover { color: var(--saffron); }

  .share-links { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .share-link { font-family: 'DM Sans', sans-serif; font-size: 0.65rem; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; border: 1px solid #333; padding: 0.3rem 0.65rem; border-radius: 2px; transition: all 0.2s; background: var(--ink); color: #999; }
  .share-link:hover { border-color: var(--saffron); color: var(--saffron); }

  /* ─── MORE ARTICLES ─── */
  .more-articles-section { background: var(--cream); border-top: 1px solid var(--border); padding: 4rem 2rem; }
  .container { max-width: 1180px; margin: 0 auto; padding: 0 2rem; }
  .section-header { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 3rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
  .section-label { font-family: 'DM Sans', sans-serif; font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--saffron); display: block; margin-bottom: 0.3rem; }
  .section-title { font-family: 'Noto Serif Devanagari', 'Playfair Display', serif; font-size: 1.8rem; font-weight: 600; color: var(--ink); }
  .section-link { font-family: 'DM Sans', sans-serif; font-size: 0.75rem; font-weight: 500; color: var(--saffron); text-decoration: none; letter-spacing: 0.1em; text-transform: uppercase; }
  .section-link:hover { text-decoration: underline; }

  .more-articles-grid { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .article-card { border-top: 3px solid var(--border); padding-top: 1.5rem; transition: border-color 0.2s; opacity: 0; transform: translateY(24px); }
  .article-card.visible { opacity: 1; transform: translateY(0); transition: opacity 0.55s ease, transform 0.55s ease; }
  .article-card:hover { border-color: var(--saffron); }
  .article-card-meta { font-family: 'DM Sans', sans-serif; font-size: 0.7rem; color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.6rem; }
  .article-card-title { font-family: 'Noto Serif Devanagari', serif; font-size: 1rem; font-weight: 600; line-height: 1.4; color: var(--ink); margin-bottom: 0.75rem; text-decoration: none; display: block; transition: color 0.2s; }
  .article-card-title:hover { color: var(--saffron); }
  .article-card-excerpt { font-family: 'Noto Serif Devanagari', serif; font-size: 0.85rem; color: var(--muted); line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-tags { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem; }
  .card-tag { font-family: 'DM Sans', sans-serif; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; background: var(--parchment); color: var(--muted); border: 1px solid var(--border); padding: 0.2rem 0.6rem; border-radius: 999px; }

  /* ─── NEWSLETTER ─── */
  .newsletter-section { background: var(--ink); text-align: center; padding: 5rem 2rem; }
  .newsletter-title { font-family: 'Noto Serif Devanagari', serif; font-size: 1.8rem; font-style: italic; color: var(--parchment); margin-bottom: 0.75rem; }
  .newsletter-subtitle { font-family: 'DM Sans', sans-serif; font-size: 0.85rem; color: #888; margin-bottom: 2.5rem; }
  .newsletter-form { display: flex; gap: 0.75rem; max-width: 440px; margin: 0 auto; }
  .newsletter-form input { flex: 1; background: rgba(255,255,255,0.06); border: 1px solid #444; border-radius: 2px; padding: 0.85rem 1.2rem; color: var(--parchment); font-family: 'EB Garamond', serif; font-size: 0.95rem; outline: none; transition: border-color 0.2s; }
  .newsletter-form input::placeholder { color: #666; }
  .newsletter-form input:focus { border-color: var(--saffron); }
  .newsletter-form button { background: var(--saffron); border: none; color: white; font-family: 'DM Sans', sans-serif; font-size: 0.78rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.85rem 1.5rem; border-radius: 2px; cursor: pointer; transition: background 0.2s; white-space: nowrap; }
  .newsletter-form button:hover { background: #c94f00; }

  /* ─── FOOTER ─── */
  footer { background: #0E0B04; border-top: 3px solid var(--saffron); padding: 3rem 2rem; }
  .footer-inner { max-width: 1180px; margin: 0 auto; display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }
  .footer-brand .logo-text { font-size: 1.3rem; display: block; margin-bottom: 0.5rem; }
  .footer-tagline { font-family: 'Noto Serif Devanagari', serif; font-size: 0.9rem; color: #666; margin-top: 0.75rem; line-height: 1.6; }
  .footer-col h4 { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--saffron); margin-bottom: 1.2rem; }
  .footer-col a { display: block; font-family: 'DM Sans', sans-serif; font-size: 0.82rem; color: #777; text-decoration: none; margin-bottom: 0.6rem; transition: color 0.2s; }
  .footer-col a:hover { color: var(--parchment); }
  .social-links { display: flex; gap: 0.75rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .social-link { font-family: 'DM Sans', sans-serif; font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: #666; text-decoration: none; border: 1px solid #333; padding: 0.35rem 0.75rem; border-radius: 2px; transition: all 0.2s; }
  .social-link:hover { border-color: var(--saffron); color: var(--saffron); }
  .footer-bottom { max-width: 1180px; margin: 0 auto; border-top: 1px solid #222; padding-top: 2rem; display: flex; justify-content: space-between; align-items: center; }
  .footer-copy { font-family: 'DM Sans', sans-serif; font-size: 0.72rem; color: #555; }
  .footer-legal { display: flex; gap: 1.5rem; }
  .footer-legal a { font-family: 'DM Sans', sans-serif; font-size: 0.7rem; color: #555; text-decoration: none; transition: color 0.2s; }
  .footer-legal a:hover { color: var(--saffron); }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

  @media (max-width: 900px) { .more-articles-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 768px) {
    nav { display: none; }
