<script>
  // ── Progress bar ──
  window.addEventListener('scroll', () => {
    const doc = document.documentElement;
    const pct = (doc.scrollTop / (doc.scrollHeight - doc.clientHeight)) * 100;
    document.getElementById('progress-bar').style.width = pct + '%';
  }, { passive: true });

  // ── TOC active ──
  const tocItems = document.querySelectorAll('#toc li[data-target]');
  const headingIds = Array.from(tocItems).map(li => li.dataset.target);
  function updateToc() {
    let active = headingIds[0];
    headingIds.forEach(id => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= el.getBoundingClientRect().top + window.scrollY - 160) active = id;
    });
    tocItems.forEach(li => li.classList.toggle('active', li.dataset.target === active));
  }
  window.addEventListener('scroll', updateToc, { passive: true });
  updateToc();

  // ── Card animation ──
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((e, i) => {
      if (e.isIntersecting) { setTimeout(() => e.target.classList.add('visible'), i * 100); observer.unobserve(e.target); }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('.article-card').forEach(c => observer.observe(c));

  // ── Save ──
  function toggleSave(btn) {
    const saved = btn.classList.toggle('active');
    btn.textContent = saved ? '★ सहेजा' : '☆ सहेजें';
  }

  // ── Copy link ──
  function copyLink(btn) {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const orig = btn.textContent;
      btn.textContent = '✓ कॉपी हो गया!';
      btn.classList.add('active');
      setTimeout(() => { btn.textContent = orig; btn.classList.remove('active'); }, 2000);
    });
  }

  // ── Newsletter ──
  document.querySelector('.newsletter-form button').addEventListener('click', function() {
    const input = document.querySelector('.newsletter-form input');
    if (input.value && input.value.includes('@')) {
      this.textContent = 'सदस्यता हो गई ✓';
      this.style.background = '#2d7a2d';
      input.value = '';
      setTimeout(() => { this.textContent = 'सदस्यता लें'; this.style.background = ''; }, 3000);
    } else {
      input.style.borderColor = 'var(--saffron)';
      input.focus();
    }
  });

  // ── Hamburger ──
  const hamburger = document.getElementById('hamburger');
  const mobileNav = document.getElementById('mobileNav');
  hamburger.addEventListener('click', () => {
    const open = mobileNav.classList.toggle('open');
    hamburger.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.querySelectorAll('.mobile-link').forEach(link => {
    link.addEventListener('click', () => {
      mobileNav.classList.remove('open');
      hamburger.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  // ── Language bar ──
  function rjLang(lang) {
    try { localStorage.setItem('rajyaniti-lang', lang); } catch {}
    document.querySelectorAll('[data-rj]').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.rj === lang);
    });
    if (lang === 'en') window.location.href = 'article.html';
    if (lang === 'ta') window.location.href = 'article-ta.html';
  }
</script>

